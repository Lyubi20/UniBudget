<Window x:Class="UniBudget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniBudget" Height="500" Width="760" WindowStartupLocation="CenterScreen" Background="#F3F4F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="2,0,2,16">
            <DockPanel>
                <TextBlock x:Name="lblBudget" Text="Свободен бюджет: 0.00 €" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                <Border x:Name="statusBadge" Background="Green" CornerRadius="8" Padding="10,3" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtStatus" Text="Спокоен" Foreground="White" FontWeight="Bold"/>
                </Border>
            </DockPanel>
            <TextBlock x:Name="lblDaily" Text="Дневен лимит: 0.00 € / ден" FontSize="14" Foreground="#374151" Margin="0,4"/>
            <ProgressBar x:Name="pbBudget" Height="10" Maximum="100" Value="100" Foreground="Green" Background="#E5E7EB" BorderThickness="0" Margin="0,6"/>
            <TextBlock x:Name="lblStudentStats" FontSize="13" Foreground="#4B5563" Margin="0,2,0,0"/>
        </StackPanel>

       
        <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="10" Padding="18" Margin="0,0,15,0">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Нов запис" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>
                <TextBlock Text="Сума (€)" FontWeight="SemiBold" Foreground="#4B5563"/>
                <TextBox x:Name="txtAmount" Margin="0,4,0,12"/>
                <TextBlock Text="Категория" FontWeight="SemiBold" Foreground="#4B5563"/>
                <ComboBox x:Name="cmbCategory" Height="32" Padding="8,0" VerticalContentAlignment="Center" SelectedIndex="0" Margin="0,4,0,12">
                    <ComboBoxItem Content="Храна"/>
                    <ComboBoxItem Content="Образование"/>
                    <ComboBoxItem Content="Транспорт"/>
                    <ComboBoxItem Content="Развлечения"/>
                    <ComboBoxItem Content="Помощ от родители (+)"/>
                    <ComboBoxItem Content="Работа (+)"/>
                </ComboBox>
                <TextBlock Text="Описание (по желание)" FontWeight="SemiBold" Foreground="#4B5563"/>
                <TextBox x:Name="txtDesc" Margin="0,4,0,18"/>
                <Button Content="Запиши" Click="BtnAdd_Click" IsDefault="True" Height="38" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Border>

      
        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Изтрий избрания запис" Click="BtnDelete_Click" Height="34" Margin="0,10,0,0" Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <ListBox x:Name="lstExpenses" BorderThickness="0" FontSize="13"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>